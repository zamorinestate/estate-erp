# Zamorin local ESC/POS bridge configuration.
# Load these variables only on the café terminal that runs
# scripts/zamorin_local_printer_bridge.mjs.

ZAMORIN_PRINTER_TRANSPORT=NETWORK_TCP
ZAMORIN_PRINTER_HOST=192.168.1.50
ZAMORIN_PRINTER_PORT=9100
ZAMORIN_PRINTER_ID=COUNTER-01-THERMAL

# Required endpoint pin. The bridge computes SHA-256 over the canonical
# transport/host/port/printerId tuple and refuses printing if this differs.
# Start the bridge once without this value and read printerEndpointFingerprint
# from GET http://127.0.0.1:9199/health, then copy that 64-hex value here.
# This protects local configuration integrity; it is NOT cryptographic proof
# of the printer hardware itself.
ZAMORIN_PRINTER_ENDPOINT_SHA256=

# Optional comma-separated browser origins allowed to call the local bridge.
# The canonical production origin and localhost development origins are already
# included by default.
ZAMORIN_BRIDGE_ALLOWED_ORIGINS=


# Required server dispatch-verification key. This is the NON-SECRET Ed25519
# SPKI DER public key (base64) corresponding to the backend private signer.
# The bridge refuses every /print request unless its authorization verifies.
ZAMORIN_PRINT_DISPATCH_PUBLIC_KEY_SPKI_B64=
