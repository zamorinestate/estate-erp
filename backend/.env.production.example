# =============================================================================
# ZAMORIN CAFE ERP — PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# =============================================================================
# Instructions:
# 1. Copy this file to .env on your production server or configure these keys in
#    your cloud hosting provider (Render, Railway, AWS, DigitalOcean, etc.).
# 2. Replace all placeholder values with secure, production-grade credentials.
# 3. Never commit this file or real secrets into version control.
# =============================================================================

# ── Core Runtime Configuration ────────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
TZ=Asia/Kolkata

# ── Database Configuration (MongoDB 6.0+ Atlas or Replica Set) ────────────────
# CRITICAL: Multi-document transactions require MongoDB Atlas (M0/M10+) or Replica Set (rs0).
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>.mongodb.net/zamorin_cafe_erp?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000

# Optional: Override DNS resolution servers for Atlas connectivity
DNS_SERVERS=8.8.8.8,1.1.1.1

# ── CORS & Domain Security ────────────────────────────────────────────────────
# Exact allowed HTTP/HTTPS origins. Comma-separated. Wildcards (*) are rejected.
ALLOWED_ORIGINS=https://app.zamorincafe.com,https://zamorin-cafe-erp.vercel.app

# ── Cryptographic Secrets & Authentication ────────────────────────────────────
# Must be at least 32 cryptographically random characters (e.g. openssl rand -base64 32)
JWT_ACCESS_SECRET=<SET_PRODUCTION_JWT_ACCESS_SECRET>
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Session Security Policies
SESSION_ABSOLUTE_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=30
STEP_UP_AUTH_MAX_AGE_MINUTES=10

# MFA Encryption Key: Exact 64-character hexadecimal string (32 bytes hex-encoded)
# Generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=<SET_PRODUCTION_MFA_64_HEX_KEY>

# Attendance signing secrets must be distinct and at least 32 random characters.
QR_SIGNING_SECRET=<SET_DISTINCT_QR_SIGNING_SECRET>
ATTENDANCE_QR_SECRET=<SET_DISTINCT_ATTENDANCE_QR_SECRET>

# ── Initial Primary Master Provisioning (Idempotent Seed) ─────────────────────
# Used by startProd.js to bootstrap the initial Primary Master admin account safely.
INITIAL_ORGANISATION_ID=ZAMORIN
INITIAL_MASTER_NAME=Zamorin Primary Master
INITIAL_MASTER_EMAIL=<SET_PRIMARY_MASTER_EMAIL>
INITIAL_MASTER_PASSWORD=<SET_PRIMARY_MASTER_PASSWORD>

# ── High-Concurrency Rate Limiter Configuration ───────────────────────────────
RATE_LIMIT_MAX=50000

# ── File & Binary Object Storage Driver ───────────────────────────────────────
# Options: 'cloudinary' (recommended for stateless cloud containers) or 'local' (persistent disk)
PRIVATE_STORAGE_DRIVER=local

# Cloudinary Configuration (Required only if PRIVATE_STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Durable Business Document Storage ─────────────────────────────────────────
DOCUMENT_STORAGE_PROVIDER=gridfs
DOCUMENT_GRIDFS_BUCKET=zamorinDocuments
DOCUMENT_STORAGE_MAX_BYTES=15728640
