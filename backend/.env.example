# Zamorin Cafe ERP backend environment template.
# Copy this file to .env for local development only.
# Configure the same keys in Render for production. Never commit real values.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# MongoDB Atlas connection. Replace every placeholder locally or in Render.
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@ATLAS_CLUSTER_HOST/zamorin_cafe_erp?retryWrites=true&w=majority
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0

# Shared distributed state. Required in production; use Render Key Value's
# internal Redis-compatible URL so rate limiting, presence, locks and jobs
# never fall back to process-local state.
REDIS_URL=
REDIS_KEY_PREFIX=zamorin:

# Comma-separated exact frontend origins. Wildcards are rejected.
# Development example: http://localhost:3000
# Production example: https://your-zamorin-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Generate unique production secrets. Do not reuse or commit them.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=30
STEP_UP_AUTH_MAX_AGE_MINUTES=10
MFA_ENCRYPTION_KEY=replace-with-a-secure-random-64-character-hex-key

# Attendance QR and scan-grant signing. Production requires two distinct,
# high-entropy secrets of at least 32 characters.
QR_SIGNING_SECRET=
ATTENDANCE_QR_SECRET=

# Initial seed account values. Replace before running the seed command.
INITIAL_ORGANISATION_ID=ZAMORIN
INITIAL_MASTER_NAME=Zamorin Master
INITIAL_MASTER_EMAIL=master@example.com
INITIAL_MASTER_PASSWORD=ReplaceWithStrongPassword123!

# Local/demo seed credentials. Required only when demo data is explicitly seeded.
# Supply actual values through your local secret store; never commit them.
SEED_DEMO_PASSWORD=<set-in-local-secret-store>
SEED_CAFE_OPERATIONS_PIN=<six-digit-local-demo-pin>
SEED_OPERATOR_PIN_1=<six-digit-local-demo-pin>
SEED_OPERATOR_PIN_2=<six-digit-local-demo-pin>

# Android hardware key-attestation policy.
# Package defaults to the canonical production applicationId.
ZAMORIN_ANDROID_APP_PACKAGE=com.zamorin.cafe.erp
# Comma-separated SHA-256 digest(s) of the legitimate Android app-signing
# certificate(s). Required in production. Keep the old + new digest during an
# intentional signing-key rotation window, then remove the retired digest.
ZAMORIN_ANDROID_APP_CERT_SHA256=

# Password reset delivery. Local logging must never be enabled in production.
PASSWORD_RESET_DEV_LOG_CODE=false

# Private binary storage. Local is development-only; production requires cloudinary.
PRIVATE_STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Business Document Storage (MongoDB Atlas GridFS).
# Production canonical storage uses MongoDB Atlas GridFS (zamorinDocuments bucket).
# Ephemeral container filesystem and S3/R2 are not used.
DOCUMENT_STORAGE_PROVIDER=gridfs
DOCUMENT_GRIDFS_BUCKET=zamorinDocuments
DOCUMENT_STORAGE_MAX_BYTES=15728640

# ClamAV is an isolated document-subsystem dependency. Core API readiness does
# not require it unless explicitly enabled; document scanning remains fail-closed.
REQUIRE_DOCUMENT_SCANNER=false
CLAMAV_HOST=
CLAMAV_PORT=3310

# Local development only override:
# DOCUMENT_STORAGE_ROOT=./uploads/dev_documents

# Trusted reverse-proxy configuration (comma-separated IP addresses, CIDR blocks, or keywords: loopback, linklocal, uniquelocal)
# Defaults to: loopback,linklocal,uniquelocal. Example with custom load balancers:
# TRUSTED_PROXY_CIDRS=loopback,linklocal,uniquelocal,198.51.100.0/24

# Authentication rate limiting thresholds (optional overrides)
# RATE_LIMIT_MAX=50000
# AUTH_RATE_LIMIT_IP_MAX=50
# AUTH_RATE_LIMIT_ACCOUNT_MAX=10


# Server-authorized local ESC/POS dispatch signing.
# Ed25519 private key encoded as PKCS#8 DER then base64. Required in production.
# Install only the corresponding SPKI public key on café bridge hosts.
ZAMORIN_PRINT_DISPATCH_PRIVATE_KEY_PKCS8_B64=
