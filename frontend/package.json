{
  "name": "zamorin-cafe-erp-frontend",
  "version": "1.0.0",
  "description": "Zamorin Cafe ERP — Enterprise Web Application UI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/serve_frontend.js",
    "serve": "node ../scripts/serve_frontend.js",
    "verify:imports": "node verifyRouterImports.mjs",
    "verify:all": "node ../scripts/verify_all_master.mjs",
    "build:css": "npx @tailwindcss/cli -i src/styles/tailwind-input.css -o src/styles/tailwind.css",
    "build:css:prod": "npx @tailwindcss/cli -i src/styles/tailwind-input.css -o src/styles/tailwind.css --minify",
    "build:css:input": "npx @tailwindcss/cli -i input.css -o src/styles/tailwind.css --minify",
    "build:prod": "npm run build:css:prod",
    "build": "npm run build:css:prod"
  },
  "keywords": [
    "zamorin-cafe-erp",
    "frontend",
    "vanilla-js",
    "es-modules",
    "pwa"
  ],
  "author": "Zamorin Cafe Operations Engineering",
  "license": "UNLICENSED",
  "main": "sw.js",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "flowbite": "^4.0.2",
    "tailwindcss": "^4.3.3"
  }
}
